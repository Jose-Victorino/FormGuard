{
  "compilerOptions": {
    "types": ["vite/client"],
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      "svg/*": ["./src/assets/svg/*"]
    },
    "jsx": "react-jsx",
    "checkJs": true,
    "strict": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "build"]
}